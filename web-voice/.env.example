# The example starts in mock mode. Set this to live only after adding both values below.
NEXT_PUBLIC_OMNIDIM_MODE=mock

# Used only by app/api/session. Never prefix this variable with NEXT_PUBLIC_.
OMNIDIM_API_KEY=

# The numeric ID of the voice agent visitors should speak to.
OMNIDIM_AGENT_ID=

# Local draft-preview mode. These values work only while `npm run dev` is
# running, and should stay in an untracked .env.local file.
# OMNIDIM_API_BASE_URL=http://127.0.0.1:8069
# OMNIDIM_LOCAL_WEB_SOCKET_BASE_URL=ws://127.0.0.1:3002
# OMNIDIM_LOCAL_DEMO_USER_ID=2943
